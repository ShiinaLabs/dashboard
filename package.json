{
  "name": "dashboard",
  "type": "module",
  "engines": {
    "node": "^20.0.0"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "react-router dev",
    "mock": "MOCK_DATA=1 NEXT_PUBLIC_MOCK_DATA=1 react-router dev",
    "build": "pnpm run build:client && pnpm run build:server",
    "start": "node server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:client": "RR_SKIP_SSR=1 NODE_OPTIONS=\"--max-old-space-size=512 --max-semi-space-size=8\" react-router build",
    "build:server": "RR_SKIP_CLIENT=1 NODE_OPTIONS=\"--max-old-space-size=160 --max-semi-space-size=8\" react-router build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "@chenglou/pretext": "^0.0.8",
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@mantine/notifications": "9.6.0",
    "@react-router/node": "^7.18.2",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^7.0.77",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5",
    "jose": "^6.2.3",
    "lodash": "^4.17.21",
    "lucide-react": "^1.17.0",
    "pg": "8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^7.18.2",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.0",
    "twitter-api-v2": "^1.18.2",
    "twitter-openapi-typescript": "^0.0.56",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/lodash": "^4.17.0",
    "@types/node": "^26.1.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.0.0",
    "tailwindcss": "^4.3.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
