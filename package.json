{
  "name": "dashboard",
  "type": "module",
  "engines": {
    "node": "^20.0.0"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "react-router dev",
    "mock": "HTTPS=false MOCK_DATA=1 NEXT_PUBLIC_MOCK_DATA=1 ANALYTICS_PUBLIC_ORIGIN=https://dashboard.example react-router dev",
    "build": "pnpm run build:client && pnpm run build:server",
    "start": "node server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:client": "RR_SKIP_SSR=1 NODE_OPTIONS=\"--max-old-space-size=512 --max-semi-space-size=8\" react-router build",
    "build:server": "RR_SKIP_CLIENT=1 NODE_OPTIONS=\"--max-old-space-size=160 --max-semi-space-size=8\" react-router build",
    "test:e2e": "playwright test"
  },
