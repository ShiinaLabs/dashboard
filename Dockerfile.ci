# The GitLab test job builds with Node 24 and passes production dependencies
# and React Router assets here. This stage only assembles the runtime image.
FROM --platform=linux/amd64 gcr.io/distroless/nodejs24-debian13:nonroot@sha256:9eeb7f5887d0e239e78264b06f7f11d2e14be534050481803a9e4728fcdd278e AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV DATA_DIR=/app/data
ENV NODE_OPTIONS=--max-old-space-size=256

# ADD extracts the archive while preserving pnpm's relative symlinks into .pnpm.
ADD --chown=1001:1001 .ci-runtime/node_modules.tar.gz /app/
COPY --chown=1001:1001 .ci-runtime/app-build ./build
COPY --chown=1001:1001 package.json ./package.json
COPY --chown=1001:1001 public/a/t.js ./build/client/a/t.js
COPY --chown=1001:1001 server ./server
COPY --chown=1001:1001 docker/runtime-data/ ./data/

USER 1001:1001
EXPOSE 3000
CMD ["/app/server/index.mjs"]
