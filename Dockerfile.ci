# The GitLab test job runs the production build on every relevant branch and
# passes it here as a short-lived artifact. Keep image assembly from rebuilding
# the same React Router client and server bundles a second time in Kaniko.
FROM reg.mikumikumi.xyz/mirror/node:22-bookworm-slim AS runner
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs dashboard \
  && mkdir -p /app/data/db /app/data/logs

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV DATA_DIR=/app/data
ENV NODE_OPTIONS=--max-old-space-size=256

# Production dependencies only (native addons ship prebuilt binaries).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN COREPACK_NPM_REGISTRY=https://registry.npmmirror.com \
  pnpm_config_registry=https://registry.npmmirror.com \
  pnpm install --prod --frozen-lockfile --child-concurrency=1 --network-concurrency=4

# React Router build artifact + minimal HTTP entry.
COPY --chown=dashboard:nodejs .ci-build/build ./build
COPY --chown=dashboard:nodejs public/a/t.js ./build/client/a/t.js
COPY --chown=dashboard:nodejs server ./server
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 3000

CMD ["docker-entrypoint.sh"]
